<Project>

	<!--
		Default properties for Tailwind CSS CLI integration.
		All properties can be overridden in the consuming project before importing the targets.
	-->
	<PropertyGroup>
		<!-- Tailwind CSS CLI version to download -->
		<TailwindToolsVersion Condition="'$(TailwindToolsVersion)' == ''">4.3.2</TailwindToolsVersion>

		<!-- Input CSS file path (relative to TailwindWorkingDirectory) -->
		<TailwindInputCss Condition="'$(TailwindInputCss)' == ''">Styles/tailwind.css</TailwindInputCss>

		<!-- Output CSS file path (non-minified, relative to TailwindWorkingDirectory) -->
		<TailwindOutputCss Condition="'$(TailwindOutputCss)' == ''">wwwroot/css/app.css</TailwindOutputCss>

		<!-- Output CSS file path (minified, relative to TailwindWorkingDirectory) -->
		<TailwindOutputCssMinified Condition="'$(TailwindOutputCssMinified)' == ''">wwwroot/css/app.min.css</TailwindOutputCssMinified>

		<!-- Whether to generate the non-minified CSS file (default: true) -->
		<TailwindGenerateUnminified Condition="'$(TailwindGenerateUnminified)' == ''">true</TailwindGenerateUnminified>

		<!-- Whether to generate the minified CSS file (default: true) -->
		<TailwindGenerateMinified Condition="'$(TailwindGenerateMinified)' == ''">true</TailwindGenerateMinified>

		<!-- Working directory for Tailwind CLI execution -->
		<TailwindWorkingDirectory Condition="'$(TailwindWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</TailwindWorkingDirectory>

		<!-- Directory where the Tailwind CLI binary is stored -->
		<TailwindExeDir Condition="'$(TailwindExeDir)' == ''">$([System.IO.Path]::Combine($(TailwindWorkingDirectory), ".tailwind"))</TailwindExeDir>

		<!-- Extra arguments to pass to the Tailwind CLI (e.g., additional flags) -->
		<TailwindExtraArgs Condition="'$(TailwindExtraArgs)' == ''"></TailwindExtraArgs>
	</PropertyGroup>

</Project>
